# ─── Magicline Open API ───────────────────────────────────────────────
ML_TENANT=fit-inn-trier
ML_API_KEY=DEIN_NEUER_KEY_HIER      # ← den NEU generierten Key eintragen, niemals committen!

# ─── Anzeige ──────────────────────────────────────────────────────────
MAX_CAPACITY=80                     # Maximale Personenzahl für die Ampel
CACHE_TTL_MS=45000                  # Magicline wird höchstens alle 45s abgefragt

# ─── Ampel-Schwellen (Prozent) ────────────────────────────────────────
YELLOW_AT=50                        # ab hier gelb
RED_AT=80                           # ab hier rot

# ─── CORS ─────────────────────────────────────────────────────────────
# '*' = von überall abrufbar (Daten sind anonym/aggregiert, daher unkritisch).
# Optional einschränken, z.B.: https://www.fit-inn-trier.de
ALLOWED_ORIGIN=*

# ─── Port (Container-intern) ──────────────────────────────────────────
PORT=8080

# ─── Eigene App (Capacitor): Push via Firebase Cloud Messaging ─────────
# Aus der Service-Account-JSON (Firebase Console → Projekteinstellungen →
# Dienstkonten → privaten Schlüssel generieren). NICHT committen, nur als Env-Var.
FCM_PROJECT_ID=                     # "project_id"
FCM_CLIENT_EMAIL=                   # "client_email"
FCM_PRIVATE_KEY=                    # "private_key" (mehrzeilig; \n bleiben erhalten)

# ─── Eigene App: Login „Mit Apple/Google anmelden" ────────────────────
# Erlaubte Zielgruppen (aud) der ID-Tokens; mehrere mit Komma trennen.
GOOGLE_CLIENT_ID=                   # iOS/Android-OAuth-Client-ID(s) aus Google Cloud
APPLE_CLIENT_ID=                    # App-Bundle-ID(s), z. B. de.fitinn.portal

# ─── App-Store-/Play-Store-Prüfung: Demo-/Reviewer-Login ──────────────
# Fester Test-Zugang mit festem Code (kein echter Versand), damit Apple/Google
# die App testen können. Nur aktiv, wenn ALLE vier gesetzt sind. Nach der
# Freigabe kannst du sie wieder entfernen.
DEMO_LOGIN_EMAIL=                   # z. B. apple-review@fit-inn-trier.de (muss nichts empfangen)
DEMO_LOGIN_DOB=                     # Geburtsdatum des Demo-Kontos (TT.MM.JJJJ ODER JJJJ-MM-TT)
DEMO_LOGIN_CODE=                    # fester 6-stelliger Code, z. B. 246810
DEMO_CUSTOMER_NUMBER=               # Mitgliedsnummer des Demo-Kontos, z. B. M-2076 (empfohlen)
DEMO_CUSTOMER_ID=                   # optional: interne Magicline-ID statt Mitgliedsnummer

# ─── Eigene App: Deep-Links (optional) ────────────────────────────────
APPLE_APP_ID=                       # TEAMID.BUNDLEID, z. B. ABCDE12345.de.fitinn.portal
ANDROID_PACKAGE=                    # z. B. de.fitinn.portal
ANDROID_SHA256=                     # SHA-256-Fingerabdruck(e) des Signing-Keys, Komma-getrennt

# ─── Open Food Facts (Produktkatalog/Barcode fürs Ernährungsmodul) ─────
# Pflicht-Kontaktadresse für den User-Agent (Open-Food-Facts-Richtlinie). Ohne
# gültige Adresse meldet der Dienst „not_configured" und macht KEINE externen
# Abfragen (Fallback: manuelle Eingabe / KI-Schätzung). Keine erfundene Adresse.
OPENFOODFACTS_CONTACT_EMAIL=            # z. B. app@fit-inn-trier.de
OPENFOODFACTS_PRODUCT_LIMIT_PER_MINUTE=60   # globales OFF-Produktlimit (app-weit; OFF erlaubt ~100/min)
OPENFOODFACTS_SEARCH_LIMIT_PER_MINUTE=8     # globales OFF-Suchlimit (app-weit)
OPENFOODFACTS_FRESH_DAYS=7                  # Produkt jünger als X Tage: direkt aus Katalog
OPENFOODFACTS_MAX_STALE_DAYS=30            # ab X Tagen Aktualisierung bevorzugen
# OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org   # optional (Tests/Länder-Instanz)
# OPENFOODFACTS_TIMEOUT_MS=4500                             # optional
# CRON_SECRET=                             # nur falls ein optionaler „Hot-Refresh"-Cron ergänzt wird

# ─── Stripe: Premium-Abo fürs Ernährungsmodul (Freemium) ──────────────
# Basis-Funktionen (loggen, Barcode, Wasser, Kochbuch, Verlauf, Export) sind
# gratis; die KI-Funktionen (Foto-Analyse, FINN-Coach, Wochenplan, KI-Rezepte,
# Wochen-Auswertung) sind Premium: 4,99 €/Monat, 7 Tage gratis testen.
# Ohne STRIPE_SECRET_KEY + STRIPE_PRICE_ID meldet die Abrechnung „not_configured"
# und es wird nichts verkauft (Modul läuft dann komplett gratis weiter).
# Anleitung: docs/STRIPE-PREMIUM.md. Alle Werte sind Geheimnisse – NICHT committen.
STRIPE_SECRET_KEY=                  # sk_live_… (Test: sk_test_…) aus Stripe → Entwickler → API-Keys
STRIPE_PUBLISHABLE_KEY=             # pk_live_… (Test: pk_test_…) – ÖFFENTLICH, für Stripe.js (Embedded Checkout / Karte ändern)
STRIPE_PRICE_ID=                    # price_… des Abo-Preises (4,99 €/Monat, wiederkehrend)
STRIPE_WEBHOOK_SECRET=              # whsec_… aus dem Webhook-Endpoint /api/webhooks/stripe
STRIPE_TRIAL_DAYS=7                 # Gratis-Testtage (0–90); Default 7
# STRIPE_API_VERSION=2024-06-20     # optional; feste Stripe-API-Version (Default gepinnt)
APP_BASE_URL=https://mitglieder.fit-inn-trier.de   # Basis für Erfolg/Abbruch-Rücksprung nach dem Checkout

# ─── Upstash / Vercel KV (Pflicht für Premium!) ───────────────────────
# Der Premium-Status (Entitlement) UND die Webhook-Idempotenz liegen im KV-Store.
# Ohne diese Variablen kann der Stripe-Webhook nichts persistieren und die
# Abrechnung meldet „unavailable". Die Vercel/Upstash-Integration legt sie i. d. R.
# automatisch an – hier nur zur Doku (gängige Namensvarianten werden akzeptiert).
# KV_REST_API_URL=                  # bzw. UPSTASH_REDIS_REST_URL / STORAGE_REST_API_URL
# KV_REST_API_TOKEN=                # bzw. UPSTASH_REDIS_REST_TOKEN / STORAGE_REST_API_TOKEN
