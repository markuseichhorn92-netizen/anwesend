# ─── Magicline Open API ───────────────────────────────────────────────
ML_TENANT=fit-inn-trier
ML_API_KEY=DEIN_NEUER_KEY_HIER      # ← den NEU generierten Key eintragen, niemals committen!

# ─── 14-Tage-Widerruf (Fernabsatz) ────────────────────────────────────
# Das 14-tägige Widerrufsrecht gilt NUR für online/im Fernabsatz abgeschlossene
# Verträge – im Studio unterschriebene Verträge haben KEINS. Hier (kommagetrennt)
# die Magicline-„contractOrigin"-Werte eintragen, die einen Online-Abschluss
# kennzeichnen. Das generische „CONNECT_API" gilt bewusst NICHT als Online, weil
# es auch für im Studio angelegte Verträge genutzt wird. Leer lassen = sinnvoller
# Default (WEBSITE/ONLINE/WEBSHOP/E_COMMERCE/DISTANCE/FERNABSATZ …).
# CONTRACT_ONLINE_ORIGINS=WEBSITE_WIDGET,E_COMMERCE

# ─── Anzeige ──────────────────────────────────────────────────────────
MAX_CAPACITY=80                     # Maximale Personenzahl für die Ampel
CACHE_TTL_MS=45000                  # Magicline wird höchstens alle 45s abgefragt

# ─── Ampel-Schwellen (Prozent) ────────────────────────────────────────
YELLOW_AT=50                        # ab hier gelb
RED_AT=80                           # ab hier rot

# ─── CORS ─────────────────────────────────────────────────────────────
# '*' = von überall abrufbar (Daten sind anonym/aggregiert, daher unkritisch).
# Optional einschränken, z.B.: https://www.fit-inn-trier.de
ALLOWED_ORIGIN=*

# ─── Port (Container-intern) ──────────────────────────────────────────
PORT=8080

# ─── Eigene App (Capacitor): Push via Firebase Cloud Messaging ─────────
# Aus der Service-Account-JSON (Firebase Console → Projekteinstellungen →
# Dienstkonten → privaten Schlüssel generieren). NICHT committen, nur als Env-Var.
FCM_PROJECT_ID=                     # "project_id"
FCM_CLIENT_EMAIL=                   # "client_email"
FCM_PRIVATE_KEY=                    # "private_key" (mehrzeilig; \n bleiben erhalten)

# ─── Eigene App: Login „Mit Apple/Google anmelden" ────────────────────
# Erlaubte Zielgruppen (aud) der ID-Tokens; mehrere mit Komma trennen.
GOOGLE_CLIENT_ID=                   # iOS/Android-OAuth-Client-ID(s) aus Google Cloud
APPLE_CLIENT_ID=                    # App-Bundle-ID(s), z. B. de.fitinn.portal

# ─── App-Store-/Play-Store-Prüfung: Demo-/Reviewer-Login ──────────────
# Fester Test-Zugang mit festem Code (kein echter Versand), damit Apple/Google
# die App testen können. Nur aktiv, wenn ALLE vier gesetzt sind. Nach der
# Freigabe kannst du sie wieder entfernen.
DEMO_LOGIN_EMAIL=                   # z. B. apple-review@fit-inn-trier.de (muss nichts empfangen)
DEMO_LOGIN_DOB=                     # Geburtsdatum des Demo-Kontos (TT.MM.JJJJ ODER JJJJ-MM-TT)
DEMO_LOGIN_CODE=                    # fester 6-stelliger Code, z. B. 246810
DEMO_CUSTOMER_NUMBER=               # Mitgliedsnummer des Demo-Kontos, z. B. M-2076 (empfohlen)
DEMO_CUSTOMER_ID=                   # optional: interne Magicline-ID statt Mitgliedsnummer

# ─── Eigene App: Deep-Links (optional) ────────────────────────────────
APPLE_APP_ID=                       # TEAMID.BUNDLEID, z. B. ABCDE12345.de.fitinn.portal
ANDROID_PACKAGE=                    # z. B. de.fitinn.portal
ANDROID_SHA256=                     # SHA-256-Fingerabdruck(e) des Signing-Keys, Komma-getrennt

# ─── App-Test: Tester-Anmeldung (/tester) ─────────────────────────────
# Öffentliche Seite /tester sammelt Tester-E-Mails für den GESCHLOSSENEN Play-Test.
# Freigeschaltet wird im Team-Backend unter „App-Tester" (Team-Login, admin.manage) –
# es ist KEIN separates Token nötig. Diese Links sind bereits als Standard hinterlegt;
# die Env-Variablen überschreiben sie nur bei Bedarf (alle optional).
PLAY_TEST_OPTIN_URL=                # Beitritts-Link, Standard https://play.google.com/apps/testing/de.fitinn.portal
PLAY_TEST_STORE_URL=                # Store-Link, Standard https://play.google.com/store/apps/details?id=de.fitinn.portal
IOS_TEST_URL=                       # iOS App-Store-Link, Standard https://apps.apple.com/de/app/fit-inn-trier/id6785785628 (schon veröffentlicht)

# ─── Open Food Facts (Produktkatalog/Barcode fürs Ernährungsmodul) ─────
# Pflicht-Kontaktadresse für den User-Agent (Open-Food-Facts-Richtlinie). Ohne
# gültige Adresse meldet der Dienst „not_configured" und macht KEINE externen
# Abfragen (Fallback: manuelle Eingabe / KI-Schätzung). Keine erfundene Adresse.
OPENFOODFACTS_CONTACT_EMAIL=            # z. B. app@fit-inn-trier.de
OPENFOODFACTS_PRODUCT_LIMIT_PER_MINUTE=60   # globales OFF-Produktlimit (app-weit; OFF erlaubt ~100/min)
OPENFOODFACTS_SEARCH_LIMIT_PER_MINUTE=8     # globales OFF-Suchlimit (app-weit)
OPENFOODFACTS_FRESH_DAYS=7                  # Produkt jünger als X Tage: direkt aus Katalog
OPENFOODFACTS_MAX_STALE_DAYS=30            # ab X Tagen Aktualisierung bevorzugen
# OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org   # optional (Tests/Länder-Instanz)
# OPENFOODFACTS_TIMEOUT_MS=4500                             # optional

# ─── Premium über ein Magicline-Zusatzmodul (SEPA) ────────────────────
# Basis-Funktionen (loggen, Barcode, Wasser, Kochbuch, Verlauf, Export) sind
# gratis; die KI-Funktionen (Foto-Analyse, FINN-Coach, Wochenplan, KI-Rezepte,
# Wochen-Auswertung, Vital-Check) sind Premium („Coach Premium").
#
# Premium wird als Magicline-Zusatzmodul verkauft: die Abrechnung läuft über den
# bestehenden Mitgliedsvertrag per SEPA-Lastschrift. Vorteil für App Store /
# Play Store: reale, über den Vertrag abgerechnete Leistung (kein In-App-Kauf
# digitaler Güter) – kein IAP-Zwang.
#
# Aktiv NUR, wenn ML_PREMIUM_MODULE_ID gesetzt ist. Dann läuft Kauf UND Kündigung
# des Premiums über das Zusatzmodul (api/member/modules.js), gespiegelt in den
# Entitlement-Datensatz (source:'magicline', siehe lib/mlPremium.js). Ohne die
# Variable gibt es keinen In-App-Kaufweg (Premium dann nur per Team-Freischaltung).
#
# MEHRERE Varianten (alle über Magicline, alle schalten dasselbe Coach Premium frei):
#   ML_PREMIUM_MODULE_ID kann KOMMAGETRENNT mehrere Modul-IDs enthalten, z. B.:
#     ML_PREMIUM_MODULE_ID=101,102,103
#   Empfohlen: 101 = „Coach Premium Monat" (7,99 €/Mon), 102 = „Coach Premium Jahr"
#   (69,99 €/Jahr), 103 = „Vital-Starter" (79,99 €/Jahr inkl. Polar H9, 12 Mon.,
#   Gurt am Studio-Tresen ausgeben). Jede gebuchte Variante = Premium. Der Kauf-Screen
#   listet alle buchbaren Varianten (premiumOffers); ein einzelner Wert bleibt kompatibel.
#
# Voraussetzungen in Magicline:
#   • Zusatzmodul(e) mit Preis + Zahlungsfrequenz (SEPA, monatlich/jährlich) + Kündigungsfrist anlegen.
#   • API-Key-Scopes: MEMBERSHIP_SELF_SERVICE_ADDITIONAL_MODULE_READ + _WRITE (buchbar/buchen/kündigen),
#     MEMBERSHIP_SELF_SERVICE_ADDITIONAL_MODULE_CONTRACT_READ (Modul-Vertrag per ID lesen) und
#     MEMBERSHIP_SELF_SERVICE_READ (Kündigungsgründe).
# Hinweis: Die Open API kann gebuchte Module NICHT auflisten – die App merkt sich die beim
# Kauf zurückgegebene Modul-Vertrags-ID. Daher ist nur ein IN DER APP gebuchtes Premium auch
# in der App kündbar (sonst Studio-Fallback). Die Kündigung betrifft nur das Modul.
ML_PREMIUM_MODULE_ID=               # ID des Zusatzmoduls „App Premium" (leer = kein In-App-Kaufweg)

# Zusatzmodule aus der App AUSBLENDEN (kommagetrennte Modul-IDs). Für Module, die nur
# im Studio verkauft werden und nicht in der Mitglieder-App erscheinen sollen. Das Modul
# „3 Monate Ernährungsplanung inkl. Stoffwechsel-Ruheanalyse" ist zusätzlich fest per
# Namensmuster ausgeblendet (lib/mlModules.js, HIDDEN_NAME_PATTERNS).
ML_HIDDEN_MODULE_IDS=               # z. B. 201,202 (leer = nur die fest hinterlegten Muster)

# ─── Upstash / Vercel KV (Pflicht für Premium!) ───────────────────────
# Der Premium-Status (Entitlement) und der Modul-Status-Cache liegen im KV-Store.
# Ohne diese Variablen kann der Modul-Abgleich nichts persistieren und die
# Abrechnung meldet „unavailable". Die Vercel/Upstash-Integration legt sie i. d. R.
# automatisch an – hier nur zur Doku (gängige Namensvarianten werden akzeptiert).
# KV_REST_API_URL=                  # bzw. UPSTASH_REDIS_REST_URL / STORAGE_REST_API_URL
# KV_REST_API_TOKEN=                # bzw. UPSTASH_REDIS_REST_TOKEN / STORAGE_REST_API_TOKEN

# ─── Team-Backend (Mitarbeiter-Bereich /team) ──────────────────────────
# Übergangslösung geteiltes Passwort; Trainer melden sich zusätzlich per
# E-Mail-Code als echte Mitarbeiter an. Migrationsplan zu persönlichen
# Konten + MFA: docs/SECURITY.md.
TEAM_PASSWORD=
# TEAM_SESSION_TTL=43200            # Team-Session-Dauer in Sekunden (Default 12 h)

# ─── Interne/Cron-Endpunkte: Secret ist PFLICHT (fail-closed) ──────────
# /api/nudge, /api/record, /api/plan-remind, /api/social-remind,
# /api/nutrition-impulse, /api/winback-autopilot, /api/seed und
# /api/admin/off-warmup verlangen »Authorization: Bearer <Secret>«.
# OHNE gesetztes Secret antworten sie 503 – es gibt bewusst KEINEN offenen
# Betrieb mehr. Secrets NIE als Query-Parameter übergeben; der Header
# x-vercel-cron wird NICHT als Nachweis akzeptiert (frei setzbar).
CRON_SECRET=                        # zentrales Secret für alle internen Endpunkte
# RECORD_SECRET=                    # Bestands-Alias; CRON_SECRET genügt
# WINBACK_SECRET=                   # optional: eigenes Secret nur für /api/winback-autopilot
# SEED_SECRET=                      # optional: eigenes Secret nur für /api/seed
# OFF_WARMUP_KEY=                   # optional: eigenes Secret nur für /api/admin/off-warmup

# ─── Feature-Flags (serverseitig) ───────────────────────────────────────
# Werden über /api/app-info an die App ausgeliefert (features.{ern,social,demo}).
# FEATURE_ERN=0                     # NOTAUS fürs Ernährungs-Modul (gelauncht: ohne Variable AN für alle)
FEATURE_SOCIAL=0                    # 1 = Community/Trainingspartner sichtbar (opt-in, Standard aus)
FEATURE_DEMO=0                      # 1 = erlaubt den versteckten Geräte-Testmodus (NUR Staging)
SOCIAL_DEMO=0                       # 1 = Demo-Buddy „TEST99" aktiv (NUR Staging)

# ─── KI (Anthropic): FINN-Coach, Schätzungen, Antwort-Entwürfe ─────────
# Datenminimierung: An die KI gehen nur Vorname + fachlich nötige, aggregierte
# Daten – kein Nachname, keine Mitgliedsnummer, keine Bank-/Adressdaten.
# Ohne Key: Fallback-Texte, kein KI-Chat (die App bleibt voll nutzbar).
ANTHROPIC_API_KEY=
# Production: Claude via AWS Bedrock with Vercel OIDC (no static AWS keys).
# Production fails closed unless AI_PROVIDER=bedrock. The direct Anthropic fallback is development-only.
AI_PROVIDER=                       # production: bedrock
AWS_REGION=                        # must be eu-central-1 (Frankfurt)
AWS_ROLE_ARN=                      # IAM role trusted only by Vercel production OIDC
BEDROCK_MODEL_ID=                  # eu.anthropic.claude-haiku-4-5-20251001-v1:0 (EU inference profile)
BEDROCK_GUARDRAIL_ID=              # Bedrock Guardrail ID: prompt attacks + data leakage
BEDROCK_GUARDRAIL_VERSION=         # published numeric version, not DRAFT
BEDROCK_TEAM_GUARDRAIL_ID=         # separate team guardrail: allows authorized member workflows, blocks secrets/exports
BEDROCK_TEAM_GUARDRAIL_VERSION=    # published numeric version, not DRAFT
AI_REQUIRE_GUARDRAIL=1             # production fails closed if the guardrail is missing
# Optional stronger Bedrock models; IAM must explicitly allow each model first.
# BEDROCK_MODEL_PLAN_ID=
# BEDROCK_MODEL_ANALYSIS_ID=
# Do not configure AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY; OIDC supplies short-lived credentials.

# Legacy migration fallback only. Remove from production after Bedrock verification.
# AI_MODEL=                         # optional: Standard-Modell (Alltag: Chat, Hilfe, Schätzungen). Default Haiku.
# AI_MODEL_PLAN=                    # optional: stärkeres Modell NUR für Plan-Generierung (Training/Ernährung) + den Coach-Wochen-Trainings-Fokus, z. B. claude-sonnet-5. Fällt sonst auf AI_MODEL zurück.
# AI_MODEL_ANALYSIS=                # optional: stärkeres Modell NUR für Auswertungen (InBody-/Figur-/Wochen-/Mahlzeit-Bewertung + Morgen-Check/Trainingsbereitschaft), z. B. claude-sonnet-5. Fällt sonst auf AI_MODEL zurück.
# AI_TIMEOUT_MS=                    # optional: Timeout in ms

# ─── E-Mail (Resend) + Studio-Benachrichtigungen ───────────────────────
RESEND_API_KEY=
MAIL_FROM=                          # z. B. app@fit-inn-trier.de (verifizierte Domain)
MAIL_FROM_NAME=Fit-Inn Trier
MAIL_TO=                            # Studio-Postfach für interne Benachrichtigungen
# MAIL_REPLY_TO=
# INBOUND_EMAIL_DOMAIN=             # Antworten-per-Mail (Inbound-Adresse)
# INBOUND_WEBHOOK_SECRET=           # Secret des Inbound-Webhooks
# RESEND_WEBHOOK_SECRET=            # Secret für Zustell-/Lese-Status-Webhooks
# MAGICLINE_WEBHOOK_KEY=            # Shared Secret für den Magicline-Webhook. Ohne diesen Key
                                    #  ist der Empfänger AUS (503). Der Key muss dem PFAD-Segment
                                    #  der in Magicline konfigurierten URL entsprechen (oder als
                                    #  Header x-api-key gesendet werden). Zwei URL-Formen werden
                                    #  bedient (gleicher Handler):
                                    #    https://<domain>/mlhook/<KEY>
                                    #    https://<domain>/api/webhooks/ml/<KEY>
                                    #  Beispiel: URL .../api/webhooks/ml/fitinntrier  ->  KEY=fitinntrier
                                    #  (Empfehlung: statt des Tenant-Namens einen langen Zufalls-Key
                                    #   verwenden und die Magicline-URL entsprechend setzen.)
                                    #  Verarbeitete Events: CONTRACT_CREATED (Willkommensmail + Neue
                                    #  Mitglieder), APPOINTMENT_BOOKING_CREATED/UPDATED/CANCELLED
                                    #  (studioweiter Termin-Feed), CUSTOMER_CHECKIN (Live-Präsenz),
                                    #  CUSTOMER_PAYMENT_REJECTED (Team-Alarm), CUSTOMER_CREATED
                                    #  (Lead in Team-Pipeline). Diagnose: GET .../api/webhooks/ml/<KEY>?health=1
                                    #  liefert anonyme Event-Zähler (welche Webhooks kommen an?).

# OPS_KEY=                          # Shared Secret für den anonymen Betriebs-Überblick
                                    #  GET /api/ops?key=<OPS_KEY> (oder Header x-api-key). Liefert NUR
                                    #  Aggregate/Zahlen (Feedback-Kategorien, App-Fehler-Zähler,
                                    #  WhatsApp-KI-Nutzung, neue Mitglieder, Leads, Webhook-Feed) –
                                    #  KEINE Freitexte/Namen/IDs. Ohne OPS_KEY wird ersatzweise
                                    #  MAGICLINE_WEBHOOK_KEY akzeptiert; ohne beides -> 503.

# ─── WhatsApp-KI (verifizierte Mitglieder-Auskunft) ────────────────────
# FINN beantwortet Fragen eines Mitglieds zu SEINEN Daten (Vertrag, Termine,
# Training, Ernährung) direkt über WhatsApp – ERST nach 2-Faktor-Verifizierung:
#  1) die WhatsApp-Nummer muss in Magicline hinterlegt sein (Besitz),
#  2) das Mitglied bestätigt per Link Geburtsdatum + E-Mail (Wissen).
# Standardmäßig AUS (fail-closed). Braucht zusätzlich AI (Bedrock) + WhatsApp-Versand.
WA_ASSISTANT=                       # "1" schaltet die WhatsApp-KI frei (sonst nur Team-Weg)
# WA_VERIFY_TTL_DAYS=60             # optional: erneute Bestätigung nach so vielen Tagen Inaktivität (Default 60)
# WA_CONSENT_VERSION=wa-finn-2026-07 # optional: Version der WhatsApp-KI-Einwilligung (bei Textänderung erhöhen)
# Anklickbare Auswahl-Buttons (z. B. bei der Terminbuchung). Meta kann interaktive
# Nachrichten IM 24h-Fenster OHNE Vorlage senden – dort sind Buttons automatisch aktiv.
# Twilio braucht dafür eine genehmigte Quick-Reply-Content-Vorlage ({{1}}=Text,
# {{2}}..{{4}}=Button-Titel); ohne diese SID fällt FINN auf einen nummerierten Text
# zurück (das Mitglied tippt dann die Zahl – läuft dank Verlaufs-Kontext genauso weiter).
# TWILIO_QUICK_REPLY_CONTENT_SID=   # optional: Content-SID der Twilio Quick-Reply-Vorlage

# ─── „Gemeinsam kochen" (Beta) ─────────────────────────────────────────
# Teilbarer Kochtopf mit prozentualem Anteil je Person. Standardmäßig AUS
# (nur internes Testen). Freischalten für ALLE mit COOK_BETA=1; ODER gezielt
# einzelne Test-Mitglieder über eine Allowlist (kommagetrennt). Die E-Mail-Liste
# wird gegen die Magicline-Mail des Mitglieds geprüft (Ergebnis 1 h gecacht).
COOK_BETA=                          # "1" = für alle frei; leer = nur Allowlist unten
# COOK_BETA_IDS=                    # optional: Kunden-IDs der Test-Mitglieder, z. B. 12345,67890
# COOK_BETA_EMAILS=                 # optional: E-Mails der Test-Mitglieder, z. B. markus@example.com
