<?xml version="1.0" encoding="utf-8"?>
<!--
  Fit-Inn · natives Android-Plugin – Berechtigungen + Health-Connect-Verdrahtung.
  Diese Werte werden beim Build automatisch in das App-Manifest gemerged
  (Manifest-Merger), du musst sie NICHT von Hand ins App-Manifest kopieren.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth-Herzgurt (Android 12+ Laufzeitrechte) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy-BLE fuer Android < 12 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Standort (Outdoor-Training + Studio-Check-in). Auf Android < 12 auch fuer den BLE-Scan noetig. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Health Connect: AUSSCHLIESSLICH lesend.

      Jede Berechtigung hier muss einer Stelle im Code entsprechen, die sie auch
      wirklich nutzt (siehe hcPermissions in FitInnNativePlugin.kt und die Liste in
      docs/PLAY-HEALTH-CONNECT.md). Google lehnt die Freigabe ab, sobald eine
      angefragte Berechtigung keine sichtbare Funktion hat.

      NICHT wieder aufnehmen, solange nichts zurueckgeschrieben wird:
      WRITE_EXERCISE, WRITE_DISTANCE, WRITE_ACTIVE_CALORIES_BURNED
      (saveHealthWorkout meldet auf Android bewusst "not_supported")
      sowie READ_TOTAL_CALORIES_BURNED (wird nirgends gelesen).
    -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Paket-Sichtbarkeit (Android 11+): die Health-Connect-App finden + Rationale-Intent -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application>
        <!--
          Pflicht-Activity fuer Health Connect: zeigt beim Freigabe-Dialog die
          Datenschutzerklaerung. OHNE diese Activity taucht die App im Health-Connect-
          Berechtigungsschirm NICHT auf und die Freigabe schlaegt fehl.
        -->
        <activity
            android:name="de.fitinn.nativeplugin.HealthConnectRationaleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- Android <= 13 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- Android 14+ liefert die Rationale ueber diesen Intent -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
