{
  "appId": "de.fitinn.portal",
  "appName": "Fit-Inn Trier",
  "webDir": "www",
  "server": {
    "url": "https://mitglieder.fit-inn-trier.de/mitglieder",
    "cleartext": false,
    "allowNavigation": ["mitglieder.fit-inn-trier.de", "*.fit-inn-trier.de"]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0e6072"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0e6072"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
