{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/member/training.js": { "maxDuration": 120 },
    "api/member/nutrition.js": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/mlhook/:key", "destination": "/api/webhooks/magicline?key=:key" },
    { "source": "/.well-known/apple-app-site-association", "destination": "/api/well-known/apple-app-site-association" },
    { "source": "/.well-known/assetlinks.json", "destination": "/api/well-known/assetlinks" },
    { "source": "/", "destination": "/mitglieder.html" },
    { "source": "/widget", "destination": "/widget.html" },
    { "source": "/hub", "destination": "/hub.html" },
    { "source": "/auslastung", "destination": "/auslastung.html" },
    { "source": "/auslastung-mitglieder", "destination": "/auslastung-mitglieder.html" },
    { "source": "/mitglieder", "destination": "/mitglieder.html" },
    { "source": "/team", "destination": "/team-backend.html" },
    { "source": "/team/(.*)", "destination": "/team-backend.html" },
    { "source": "/werben", "destination": "/werben.html" },
    { "source": "/teilen", "destination": "/teilen.html" },
    { "source": "/einladung", "destination": "/einladung.html" },
    { "source": "/probetraining", "destination": "/probetraining.html" },
    { "source": "/probetraining-info", "destination": "/probetraining-info.html" },
    { "source": "/mitglied-werden", "destination": "/mitglied-werden.html" },
    { "source": "/konto-loeschen", "destination": "/konto-loeschen.html" },
    { "source": "/angebot", "destination": "/angebot.html" },
    { "source": "/tester", "destination": "/tester.html" },
    { "source": "/tester-werden", "destination": "/tester.html" },
    { "source": "/((?!api/|.well-known/).*)", "destination": "/mitglieder.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/((?!api/|.well-known/|widget|auslastung|auslastung-mitglieder).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), bluetooth=(self), usb=(), midi=(), magnetometer=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'" }
      ]
    }
  ]
}
