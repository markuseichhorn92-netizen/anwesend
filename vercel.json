{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mlhook/:key", "destination": "/api/webhooks/magicline?key=:key" },
    { "source": "/.well-known/apple-app-site-association", "destination": "/api/well-known/apple-app-site-association" },
    { "source": "/.well-known/assetlinks.json", "destination": "/api/well-known/assetlinks" },
    { "source": "/", "destination": "/widget.html" },
    { "source": "/hub", "destination": "/hub.html" },
    { "source": "/auslastung", "destination": "/auslastung.html" },
    { "source": "/auslastung-mitglieder", "destination": "/auslastung-mitglieder.html" },
    { "source": "/mitglieder", "destination": "/mitglieder.html" },
    { "source": "/team", "destination": "/team-backend.html" },
    { "source": "/werben", "destination": "/werben.html" },
    { "source": "/teilen", "destination": "/teilen.html" },
    { "source": "/einladung", "destination": "/einladung.html" },
    { "source": "/probetraining", "destination": "/probetraining.html" },
    { "source": "/probetraining-info", "destination": "/probetraining-info.html" },
    { "source": "/mitglied-werden", "destination": "/mitglied-werden.html" },
    { "source": "/konto-loeschen", "destination": "/konto-loeschen.html" },
    { "source": "/angebot", "destination": "/angebot.html" }
  ]
}
